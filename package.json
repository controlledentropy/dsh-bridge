{
  "name": "dsh-bridge",
  "version": "1.0.0",
  "description": "MCP stdio server that lets any MCP client create, drive, adopt and audit local DeepSeek Harness (`dsh web`) sessions over their /api.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "deepseek",
    "dsh",
    "agent",
    "orchestration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/controlledentropy/dsh-bridge.git"
  },
  "homepage": "https://github.com/controlledentropy/dsh-bridge#readme",
  "bugs": {
    "url": "https://github.com/controlledentropy/dsh-bridge/issues"
  },
  "engines": {
    "node": ">=18.14.0"
  },
  "bin": {
    "dsh-bridge": "bridge.mjs",
    "dsh-bridge-launch": "launch.mjs"
  },
  "files": [
    "bridge.mjs",
    "launch.mjs",
    "start-dsh-web.ps1",
    "lib/",
    "docs/",
    "tests/",
    "tools/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/alias-hygiene.test.mjs tests/audit-log.test.mjs tests/contract.test.mjs tests/ledger-store.test.mjs tests/mcp.test.mjs tests/remote-surface.test.mjs",
    "preflight": "node launch.mjs check",
    "surface": "node tools/remote-surface.mjs",
    "surface:check": "node tools/remote-surface.mjs --check",
    "doctor": "node launch.mjs doctor",
    "start": "node launch.mjs start",
    "check:live": "node tests/live-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  }
}
