{
  "name": "dsh-bridge",
  "version": "1.0.0",
  "description": "MCP stdio server that lets any MCP client create, drive, adopt and audit local DeepSeek Harness (`dsh web`) sessions over their /api.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "deepseek",
    "dsh",
    "agent",
    "orchestration"
  ],
  "engines": {
    "node": ">=18.14.0"
  },
  "bin": {
    "dsh-bridge": "bridge.mjs",
    "dsh-bridge-launch": "launch.mjs"
  },
  "files": [
    "bridge.mjs",
    "launch.mjs",
    "start-dsh-web.ps1",
    "lib/",
    "docs/",
    "tests/",
    "tools/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "preflight": "node launch.mjs check",
    "doctor": "node launch.mjs doctor",
    "start": "node launch.mjs start",
    "check:live": "node tests/live-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  }
}
